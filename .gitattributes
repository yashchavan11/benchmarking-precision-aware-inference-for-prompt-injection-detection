# These fixtures contain hashes of exact file bytes. Preserve LF on every platform.
tests/fixtures/synthetic/*.json text eol=lf
tests/fixtures/synthetic/*.jsonl text eol=lf
# Retained audit summaries/provenance also identify exact JSON bytes.
docs/evidence/*.json text eol=lf
docs/evidence/*.py text eol=lf
docs/evidence/p1b-recheck-20261117-*.md text eol=lf
# Nested retained predictions/manifests are also bound by exact file hashes.
docs/evidence/**/*.json text eol=lf
docs/evidence/**/*.jsonl text eol=lf
docs/evidence/**/*.csv text eol=lf
docs/evidence/**/*.txt text eol=lf
# This run bundle inventories exact native/generated bytes, including CSV CRLF.
docs/evidence/p1b-pilot-20261117/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Slurm scripts must retain Unix shebang/line endings when prepared on Windows.
scripts/*.sbatch text eol=lf
